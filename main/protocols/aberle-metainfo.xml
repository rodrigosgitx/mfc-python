	</message>

    <!--  20 : Speed telegram                    -->
    <message type="20" minBodies="1" maxBodies="1">
        <field name="source" type="String" length="12" description="Name of the position of the source"/>
        <field name="reserve" type="String" length="36" description="Reserved for future use"/>     
        <field name="status" type="StringLeftZero" length="4" description="Speed percentage 0000-0100"/>
        <field name="reserve2" type="String" length="44" description="Reserved for future use"/>                        
    </message>

