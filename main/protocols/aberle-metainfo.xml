<?xml version='1.0'?>

<protocol>
    <messageTypeDecoder class="com.inditex.wms.commoncom.impl.FieldMessageTypeDecoder" field="type"/>
    <type name="String" class="com.inditex.wms.commoncom.impl.FillTypeMetaInfo" type="java.lang.String" character="*" left="false" remove="true"/>
    <type name="StringLeftZero" class="com.inditex.wms.commoncom.impl.FillTypeMetaInfo" type="java.lang.String" character="0" left="true" remove="true"/>
    <type name="Integer" class="com.inditex.wms.commoncom.impl.FillTypeMetaInfo" type="java.lang.Integer" character="0" left="true" remove="true"/>
    <type name="TuType" class="com.inditex.wms.commoncom.aberle.TuTypeMetaInfo" />

	<header>
        <field name="sender" type="String" length="4" required="true" description="Short term for the sender"/>
        <field name="receiver" type="String" length="4" required="true" description="Short term for the receiver"/>
        <field name="length" type="Integer" length="4" required="true" description="Overall length of the the telegram"/>
        <field name="sequencenumber" type="Integer" length="2" required="true" description="Sequence number"/>
        <field name="repeatedflag" type="String" length="2" required="true" default="EE" options="EE|WW" description="Flag for repeated telegrams. EE sent for the first time, WW repeated telegram"/>
        <field name="type" type="String" length="2" required="true" description="Address scheme identifier"/>
    </header>
	
	<!-- GENERIC MESSAGES			-->

	<!--  ACKN						-->
	<message type="QQ" minBodies="1" maxBodies="1">
		<field name="errorcode" type="Integer" length="4" description="List identifier"/>
		<field name="ackn" type="String" length="4" required="true" options="ACKN" default="ACKN"  description="Reserved for future use"/>		
	</message>
	
	<!--  ALIVE						-->
	<message type="99" minBodies="1" maxBodies="1">
		<field name="reserve" type="String" length="96" description="List identifier"/>
	</message>
	
	
	<!-- MESSAGES MFS - PLC  -->
	
	<!--  01 : Transport order  	-->
	<message type="01" minBodies="1" maxBodies="1">
		<field name="source" type="String" length="12" description="Name of the position of the source"/>
		<field name="destination" type="String" length="12" description="Name of the position of the destination"/>		
		<field name="flagmanual" type="String" length="2" options="MM" description="MM is used if the telegram was created manually"/>
		<field name="tunumber" type="String" length="20" description="ID of the transport unit"/>
		<field name="status" type="String" length="2" options="00|01|10|11" description="Status flag"/>				
		<field name="device" type="String" length="4" description="Device which perform the transport"/>		
		<field name="terminator" type="String" length="2" options="EE" description="Flag to indicate the last transport in a sequence. EE: the last transport"/>	
		<field name="weight" type="String" length="8" description="Weight measured in grams"/>
		<field name="contour" type="String" length="2" description="Contour check"/>						
		<field name="height" type="String" length="2" options="01|02|03|04|05|99" description="Height types"/>							
		<field name="width" type="String" length="4" description="Width"/>	
		<field name="length" type="String" length="4" description="Length"/>						
		<field name="realheight" type="String" length="4" description="Altura real"/>
		<field name="reserve" type="String" length="18" description="Reserved for future use"/>	
    </message>
	
	<!--  02 : Transport order 		-->
